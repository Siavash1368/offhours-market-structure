# FINRA API credentials are NOT needed: the weeklySummary dataset is publicly accessible.
# If public access is ever withdrawn, create an API client at https://developer.finra.org and set:
# FINRA_API_CLIENT_ID=
# FINRA_API_CLIENT_SECRET=

# Optional: put the data store outside the repo (e.g. a short path on Windows)
# OFFHOURS_DATA_DIR=C:/data/offhours
